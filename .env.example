# APP_URL: The URL where this app is hosted.
# Used for self-referential links, notification deep links, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# NEXORA UNIVERSAL AUTH + LOCATION (Supabase)
# =============================================================================
# Only public, browser-safe values belong here. NEVER put a service_role key in
# any VITE_* variable — anything prefixed VITE_ is inlined into the client
# bundle and is publicly readable. The app refuses to start its Supabase client
# if a service_role JWT is detected in VITE_SUPABASE_ANON_KEY.

# Public Nexora project URL - points to intended project qwaehqsmodekbgvnaavz
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co

# Shared auth storage key — identical across all Nexora apps so a session is
# recognised consistently on the same origin.
VITE_SUPABASE_STORAGE_KEY=nexora.auth.qwaehqsmodekbgvnaavz

# Public anon (publishable) key from the Nexora Supabase project.
# Copy the real value into your local .env — never commit it.
# Get from: Supabase Dashboard → Project qwaehqsmodekbgvnaavz → Settings → API → Project API keys → anon public
# Example format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# This key is safe to expose in frontend (with RLS enabled) but should not be committed to git
VITE_SUPABASE_ANON_KEY=

# Optional: override the live-location table name (default: user_locations).
# VITE_NEXORA_LOCATION_TABLE=user_locations

# Optional referral backend overrides. Defaults match supabase/policies/referrals.sql.
# Only public referral codes ever appear in a URL — never a token or a user id.
# VITE_NEXORA_REFERRAL_CODES_TABLE=referral_codes
# VITE_NEXORA_REFERRALS_TABLE=referrals
# VITE_NEXORA_REFERRAL_LOOKUP_VIEW=referral_code_lookup

# Optional notification table overrides. Defaults match supabase/policies/notifications.sql.
# VITE_NEXORA_NOTIFICATIONS_TABLE=notifications
# VITE_NEXORA_NOTIFICATION_PREFERENCES_TABLE=notification_preferences
# VITE_NEXORA_NOTIFICATION_DELIVERIES_TABLE=notification_deliveries

# =============================================================================
# NOTIFICATION CHANNELS (server-side ONLY — never prefix these with VITE_)
# =============================================================================
# Read by server/notifications.ts. Without them the channel endpoints answer
# 503 { configured: false } and NOTHING is reported as sent or delivered.

# WhatsApp Cloud API. Acceptance from Meta is recorded as "sent"; "delivered"
# is only ever written by the status webhook below.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Webhook security. META_APP_SECRET enables X-Hub-Signature-256 verification;
# without either secret the status webhook rejects every callback (401).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SHARED_SECRET=
META_APP_SECRET=

# Any HTTP email API (Resend / Postmark / SendGrid-shaped).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM_ADDRESS=

# FCM HTTP v1 (push). Requires a service-account JSON and a device-token store.
FCM_SERVICE_ACCOUNT_JSON=

# Server-side Supabase access for writing the delivery log from webhooks.
# This key bypasses RLS and must NEVER be exposed to the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional catalog table overrides. Defaults match the canonical table names.
# VITE_NEXORA_SALONS_TABLE=salons
# VITE_NEXORA_SERVICES_TABLE=services
# VITE_NEXORA_CATEGORIES_TABLE=categories
# VITE_NEXORA_PROFESSIONALS_TABLE=professionals

# Force the in-repo catalog for visual QA. Leave false/unset in deployment.
# When unset, the app uses the in-repo catalog only as a graceful fallback when
# the configured Supabase catalog is empty/unavailable.
VITE_NEXORA_DEMO_MODE=false

# Customer support contact shown in Profile → Support. Public (bundled) value.
# When unset, the Support section hides the email button and says the contact
# address is not configured, rather than showing an address nobody reads.
# VITE_NEXORA_SUPPORT_EMAIL=

# =============================================================================
# LIVE VERIFICATION ONLY (Node script, not exposed to the browser bundle)
# =============================================================================
# Used by `npm run verify:live`. These are read by scripts/verify-live.mjs,
# which now auto-loads this .env file via dotenv.
NEXORA_TEST_EMAIL=
NEXORA_TEST_PASSWORD=
