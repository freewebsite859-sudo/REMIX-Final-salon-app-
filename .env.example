# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# NEXORA UNIVERSAL AUTH + LOCATION (Supabase)
# =============================================================================
# Only public, browser-safe values belong here. NEVER put a service_role key in
# any VITE_* variable — anything prefixed VITE_ is inlined into the client
# bundle and is publicly readable. The app refuses to start its Supabase client
# if a service_role JWT is detected in VITE_SUPABASE_ANON_KEY.

# Public Nexora project URL.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co

# Shared auth storage key — identical across all Nexora apps so a session is
# recognised consistently on the same origin.
VITE_SUPABASE_STORAGE_KEY=nexora.auth.qwaehqsmodekbgvnaavz

# Public anon (publishable) key from the Nexora Supabase project.
# Copy the real value into your local .env — never commit it.
VITE_SUPABASE_ANON_KEY=

# Optional: override the live-location table name (default: user_locations).
# VITE_NEXORA_LOCATION_TABLE=user_locations

# =============================================================================
# LIVE VERIFICATION ONLY (Node script, not exposed to the browser bundle)
# =============================================================================
# Used by `npm run verify:live`. These are read by scripts/verify-live.mjs,
# which now auto-loads this .env file via dotenv.
NEXORA_TEST_EMAIL=
NEXORA_TEST_PASSWORD=
