# =============================================================================
# NEXORA ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to `.env` (repo root) and fill in the real values:
#     cp .env.example .env
# `.env` is git-ignored (.gitignore) — never commit real keys.
# Layout: (1) REQUIRED live-auth/cloud vars → (2) optional public overrides →
#         (3) notification-channel secrets → (4) live-verification vars →
#         (5) where each variable is configured per environment.

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, notification deep links, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# LIVE AUTH + CLOUD EXECUTION — REQUIRED (fill these first)
# =============================================================================
# All values come from one place: Supabase Dashboard →
#   Project Settings → API
#   (direct: https://supabase.com/dashboard/project/<PROJECT_REF>/settings/api)
#
# Golden rule for naming:
#   * `VITE_`-prefixed vars  → inlined into the BROWSER bundle at build time.
#                              Only ever put PUBLIC values here (URL, anon key).
#   * No-prefix vars         → read ONLY by the Node server (service-role etc.).
#                              Never expose these to the browser.

# ---------------------------------------------------------------------------
# 1) SUPABASE_URL  (server-side service clients)
# ---------------------------------------------------------------------------
# REST URL of the Supabase project. Same value as VITE_SUPABASE_URL below —
# this bare form is read by the Node server (server/bookings.ts,
# server/engagement.ts, server/notifications.ts) for its service-role client.
# Copy from: Dashboard → Project Settings → API → Project URL
# Example: https://qwaehqsmodekbgvnaavz.supabase.co
SUPABASE_URL=

# ---------------------------------------------------------------------------
# 2) SUPABASE_SERVICE_ROLE_KEY  (server-side ONLY — SECRET)
# ---------------------------------------------------------------------------
# Service-role key for server-side writes that must bypass RLS
# (booking creation, engagement/QR endpoints, notification delivery logs,
# webhooks). Read by the same three server routers.
# Copy from: Dashboard → Project Settings → API → Project API keys →
#            `service_role` (click Reveal).
#   - SECRET. Never commit it, never put it in any VITE_* var.
#   - The app refuses to boot its browser client if it detects a service_role
#     key inside VITE_SUPABASE_ANON_KEY.
#   - If the key is ever leaked, rotate it immediately from the Dashboard
#     (Settings → API → service_role → Regenerate).
# Without this key the server endpoints answer 503 "not configured" and
# nothing is written to Supabase from the server.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 3) VITE_SUPABASE_ANON_KEY  (client-side — public)
# ---------------------------------------------------------------------------
# Public anon (publishable) key. The BROWSER client (src/lib/supabase/client.ts)
# reads ONLY this VITE_-prefixed name — the app does NOT read a bare
# `SUPABASE_ANON_KEY`, so do not invent that variable; put the anon key here.
# Copy from: Dashboard → Project Settings → API → Project API keys → `anon public`
# Example format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Safe to ship in the frontend ONLY because every table has RLS enabled.
# Quick install without copy-paste:  npm run setup:auth -- <anon-key>
#   (scripts/set-anon-key.mjs writes it into .env, validates the JWT's project
#    ref against VITE_SUPABASE_URL, and rebuilds the bundle)
VITE_SUPABASE_ANON_KEY=

# Public Nexora project URL - points to intended project qwaehqsmodekbgvnaavz.
# The browser client reads only the VITE_-prefixed form.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co

# Shared auth storage key — identical across all Nexora apps so a session is
# recognised consistently on the same origin. Leave at the default unless you
# know you need a different key.
VITE_SUPABASE_STORAGE_KEY=nexora.auth.qwaehqsmodekbgvnaavz

# ---------------------------------------------------------------------------
# Enabling the live feature flags (optional, AFTER the migration is deployed)
# ---------------------------------------------------------------------------
# Realtime subscriptions + the QR/engagement surface need their tables present
# in the live project (supabase/setup.sql + the rewards/QR/referrals migration)
# BEFORE these flags are turned on. Leave false/unset otherwise — the UI then
# shows honest offline states instead of pretending to be live.
# VITE_SUPABASE_REALTIME=false
# VITE_NEXORA_ENGAGEMENT=false

# =============================================================================
# OPTIONAL PUBLIC OVERRIDES (all VITE_ = browser-safe, all optional)
# =============================================================================

# Optional: override the live-location table name (default: user_locations).
# VITE_NEXORA_LOCATION_TABLE=user_locations

# Optional referral backend overrides. Defaults match supabase/policies/referrals.sql.
# Only public referral codes ever appear in a URL — never a token or a user id.
# VITE_NEXORA_REFERRAL_CODES_TABLE=referral_codes
# VITE_NEXORA_REFERRALS_TABLE=referrals
# VITE_NEXORA_REFERRAL_LOOKUP_VIEW=referral_code_lookup

# Optional notification table overrides. Defaults match supabase/policies/notifications.sql.
# VITE_NEXORA_NOTIFICATIONS_TABLE=notifications
# VITE_NEXORA_NOTIFICATION_PREFERENCES_TABLE=notification_preferences
# VITE_NEXORA_NOTIFICATION_DELIVERIES_TABLE=notification_deliveries

# Optional catalog table overrides. Defaults match the canonical table names.
# VITE_NEXORA_SALONS_TABLE=salons
# VITE_NEXORA_SERVICES_TABLE=services
# VITE_NEXORA_CATEGORIES_TABLE=categories
# VITE_NEXORA_PROFESSIONALS_TABLE=professionals

# Force the in-repo catalog for visual QA. Leave false/unset in deployment.
# When unset, the app uses the in-repo catalog only as a graceful fallback when
# the configured Supabase catalog is empty/unavailable.
VITE_NEXORA_DEMO_MODE=false

# ---------------------------------------------------------------------------
# GOOGLE MAPS GROUNDING (optional)
# ---------------------------------------------------------------------------
# The customer Search page has two independent switches:
#
#   1. "Google Maps grounded results" — always available. Every result is
#      checked against the coordinates stored in the salon catalog; verified
#      salons are linked straight to Google Maps and unverified ones are
#      flagged and demoted. This needs NO key and never fabricates a place.
#
#   2. "AI Maps grounding" — optional. When a backend endpoint is configured,
#      the app POSTs { query, area, city } to it and expects
#      { summary, places: [{ name, address, mapsUrl, latitude, longitude }],
#        citations: [] } back. Keep the Gemini / Google Maps Platform key on
#      that server — never in a VITE_ variable, which ships to the browser.
#      When unset, the toggle renders disabled and explains why.
#
# VITE_NEXORA_MAPS_GROUNDING_ENDPOINT=/api/maps/ground
# VITE_NEXORA_AI_MAPS_GROUNDING=false

# Customer support contact shown in Profile → Support. Public (bundled) value.
# When unset, the Support section hides the email button and says the contact
# address is not configured, rather than showing an address nobody reads.
# VITE_NEXORA_SUPPORT_EMAIL=

# =============================================================================
# NOTIFICATION CHANNELS (server-side ONLY — never prefix these with VITE_)
# =============================================================================
# Read by server/notifications.ts. Without them the channel endpoints answer
# 503 { configured: false } and NOTHING is reported as sent or delivered.

# WhatsApp Cloud API. Acceptance from Meta is recorded as "sent"; "delivered"
# is only ever written by the status webhook below.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Webhook security. META_APP_SECRET enables X-Hub-Signature-256 verification;
# without either secret the status webhook rejects every callback (401).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SHARED_SECRET=
META_APP_SECRET=

# Any HTTP email API (Resend / Postmark / SendGrid-shaped).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM_ADDRESS=

# FCM HTTP v1 (push). Requires a service-account JSON and a device-token store.
FCM_SERVICE_ACCOUNT_JSON=

# =============================================================================
# RAZORPAY (server-side ONLY — never prefix the secret with VITE_)
# =============================================================================
# Required to lock a slot with a 25% deposit. The browser never creates an
# order id or a signature. Flow:
#   POST /api/payments/orders  → Razorpay Orders API (uses these keys)
#   official checkout.js       → customer pays
#   POST /api/payments/verify  → HMAC-SHA256(order_id|payment_id, KEY_SECRET)
# A booking row is written only after verification succeeds.
# Without these keys the order endpoint answers 503 and no slot is reserved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional public copy of the key id (checkout also receives it from /orders).
# VITE_RAZORPAY_KEY_ID=

# =============================================================================
# LIVE VERIFICATION ONLY (Node script, not exposed to the browser bundle)
# =============================================================================
# Used by `npm run verify:live`. These are read by scripts/verify-live.mjs,
# which now auto-loads this .env file via dotenv. NEXORA_TEST_EMAIL/PASSWORD
# must be a real user that exists in the live Supabase project (create one via
# Dashboard → Authentication → Users, or Sign-up in the app first).
NEXORA_TEST_EMAIL=
NEXORA_TEST_PASSWORD=

# =============================================================================
# WHERE TO CONFIGURE EACH VARIABLE (deployment cheat-sheet)
# =============================================================================
# Local dev / Google Cloud Shell
#   * `cp .env.example .env` at the repo root, fill values, then:
#       npm run dev                → Vite dev server (server.ts calls
#                                    dotenv.config(); Vite auto-loads .env)
#       npm run setup:auth -- <anon-key>  → writes VITE_SUPABASE_ANON_KEY
#       npm run verify:live        → live auth/RLS smoke against the project
#   * Google Cloud Shell is EPHEMERAL (files can be wiped after ~20 days) —
#     keep the canonical .env in your own machine's secrets manager and re-copy
#     it into the shell when needed. `supabase db push` itself needs no env
#     file — only `supabase login` (access token) + `supabase link`.
#
# Browser/static hosting (Vercel, Netlify, Cloudflare Pages, etc.)
#   * Set in the platform's environment-variables UI (Project → Settings →
#     Environment Variables), AND redeploy — Vite inlines VITE_* at BUILD time:
#       VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY,
#       VITE_SUPABASE_STORAGE_KEY (+ optional VITE_NEXORA_* flags)
#
# Node server hosting (Render, Railway, Fly.io, a VPS, etc.)
#   * Set server-only vars in the platform UI:
#       SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, APP_URL,
#       and any channel secrets (WHATSAPP_*, EMAIL_*, FCM_*, META_APP_SECRET)
#   * A deployed Node server usually also serves the built client from dist/,
#     so it additionally needs the VITE_* values at BUILD time (or the static
#     client hosted separately, per the row above).
#
# Source of truth (Supabase Dashboard):
#   Project URL / anon public / service_role →
#     https://supabase.com/dashboard/project/<PROJECT_REF>/settings/api
#   Realtime publication membership → Database → Realtime
#   Test user for verify:live → Authentication → Users
